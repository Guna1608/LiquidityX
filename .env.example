# Public site URL (used for canonical URLs, sitemap and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.liquidityxacademy.com

# ---- Enrolment ----
# Set to false to close registration for the current batch (owner control; never closes automatically).
NEXT_PUBLIC_REGISTRATION_OPEN=true
# Set to 1 on a PRIVATE preview deploy to view unapproved draft articles.
SHOW_DRAFT_ARTICLES=

# ---- Market data (optional) ----
# Leave empty to run in clearly-labelled "Demo / Simulated data — Not live" mode.
# Supported: twelvedata
MARKET_DATA_PROVIDER=
TWELVEDATA_API_KEY=

# ---- Chat assistant (optional, future) ----
# Leave empty to use the local knowledge-base assistant (no external AI).
# Supported later: anthropic | openai | gemini
CHAT_AI_PROVIDER=
CHAT_AI_API_KEY=

# ---- Marketing / analytics (optional — load only after cookie consent) ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
# ---- Search console verification (optional) ----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_TWITTER_HANDLE=
